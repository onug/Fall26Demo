{
  "name": "onug-fall26-keynote-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "narration:export": "node scripts/export-script.mjs",
    "narration:generate": "node scripts/export-script.mjs && python3 scripts/generate-narration.py",
    "narration:voices": "python3 scripts/generate-narration.py --list-voices",
    "qa": "node scripts/qa.mjs && npx tsc --noEmit",
    "build:portal": "NEXT_PUBLIC_BASE_PATH=/keynote/app next build"
  },
  "dependencies": {
    "framer-motion": "^12.34.3",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
